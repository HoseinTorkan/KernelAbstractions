<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>

        <PackageId>KernelAbstractions.AspNetCore</PackageId>
        <Version>1.0.0</Version>
        <Description>
            ASP.NET Core integration for KernelAbstractions.Patterns.Provides the ApiResponse envelope for successful outcomes, RFC 7807 ProblemDetails for failures, Controller and Minimal API extensions, and ErrorType-to-HTTP status code mapping.
        </Description>
        <PackageTags>aspnetcore;result;api-response;problem-details;ddd;web-api;error-handling;functional</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\KernelAbstractions.Patterns\KernelAbstractions.Patterns.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="KernelAbstractions.AspNetCore.Tests" />
    </ItemGroup>

</Project>