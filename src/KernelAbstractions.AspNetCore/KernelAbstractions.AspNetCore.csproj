<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Target Framework -->
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>

		<!-- Package Metadata -->
		<PackageId>KernelAbstractions.AspNetCore</PackageId>
		<Version>1.0.0</Version>
		<Authors>HoseinTorkan</Authors>
		<Description>
			ASP.NET Core integration for KernelAbstractions.Patterns.Results.
			Provides the ApiResponse envelope for successful outcomes, RFC 7807
			ProblemDetails for failures, Controller and Minimal API extensions,
			and ErrorType-to-HTTP status code mapping.
		</Description>
		<PackageTags>aspnetcore;result;api-response;problem-details;ddd;web-api;error-handling;functional</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>

		<!-- Repository -->
		<RepositoryUrl>https://github.com/HoseinTorkan/KernelAbstractions</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>

		<!-- Documentation -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>

		<!-- Quality -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<AnalysisMode>Recommended</AnalysisMode>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

		<!-- Symbols -->
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<!-- Deterministic build -->
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\KernelAbstractions.Patterns\KernelAbstractions.Patterns.csproj" />
	</ItemGroup>

</Project>