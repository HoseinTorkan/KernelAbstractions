<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>

        <PackageId>KernelAbstractions.Domain</PackageId>
        <Version>3.2.0</Version>
        <Description>
            Core domain abstractions for Domain-Driven Design (DDD) and Clean
            Architecture in .NET: entities, aggregate roots, strongly-typed
            identifiers, auditing contracts, repositories, unit of work, and
            domain events.
        </Description>
        <PackageTags>ddd;clean-architecture;domain;abstractions;strongly-typed-id;auditing;repository;unit-of-work;entities;aggregate-root;marker-interfaces</PackageTags>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\KernelR.Patterns\KernelR.Patterns.csproj" />
    </ItemGroup>

</Project>